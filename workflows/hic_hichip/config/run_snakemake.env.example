SNAKEMAKE_CORES=32
SNAKEMAKE_CONDA_PREFIX=/data/user/mowp/snakemake_conda_envs
# SNAKEMAKE_CACHE_DIR=/path/to/project/.snakemake/cache
# SNAKEMAKE_TMPDIR=/path/to/project/.snakemake/cache/tmp
# SNAKEMAKE_PROXY=http://proxy.example.com:7890

# Optional FitHiChIP installation. For project-local installs, run:
#   ./scripts/install_fithichip.sh --prefix tools/FitHiChIP
# Then set:
#   FITHICHIP_HOME=tools/FitHiChIP
#   FITHICHIP_SCRIPT=tools/FitHiChIP/FitHiChIP_HiCPro.sh
FITHICHIP_ENV_NAME=bioflow-hic-hichip-fithichip
# FITHICHIP_HOME=/path/to/FitHiChIP
# FITHICHIP_SCRIPT=/path/to/FitHiChIP/FitHiChIP_HiCPro.sh
